<Window x:Class="Viewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Viewer.Wpf"
        Title="3D Viewer" Width="1024" Height="720">
    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="OpenModel_Executed" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" Command="Open" />
            </MenuItem>
        </Menu>
        <GroupBox DockPanel.Dock="Right" Header="Model Info" MinWidth="180" Margin="4">
            <local:InfoPanel />
        </GroupBox>
        <local:ViewportControl />
    </DockPanel>
</Window>