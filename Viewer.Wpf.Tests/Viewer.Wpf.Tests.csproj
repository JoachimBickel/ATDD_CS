<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows + WPF: the tests exercise the view model's Media3D conversions
         headless (freezable data objects need no window or dispatcher). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viewer.Wpf\Viewer.Wpf.csproj" />
  </ItemGroup>

</Project>